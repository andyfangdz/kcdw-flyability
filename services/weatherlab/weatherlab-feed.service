[Unit]
Description=Private KCDW Weather Lab numerical feed
Wants=network-online.target weatherlab-browser.service
After=network-online.target weatherlab-browser.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/projects/kcdw-flyability/services/weatherlab
ExecStart=%h/.hermes/node/bin/node server.mjs
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/bin
Environment=WEATHERLAB_TOKEN_FILE=%h/.local/state/weatherlab-feed/api-token
Environment=WEATHERLAB_CACHE_DIR=%h/.local/state/weatherlab-feed/cache
Restart=on-failure
RestartSec=10
TimeoutStopSec=110
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.local/state/weatherlab-feed
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
