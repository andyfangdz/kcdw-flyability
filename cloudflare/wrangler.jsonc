{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kcdw-flyability",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "kcdw-flyability-reports"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "READ_ACCESS": "public"
  },
  "account_id": "bc2c7900890ba530a55ae09a5b53f383",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.css"
      ],
      "fallthrough": true
    }
  ]
}
