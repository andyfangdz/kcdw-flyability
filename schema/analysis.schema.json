{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "source_collected_at",
    "best_day",
    "backup_day",
    "summary",
    "controlling_hazards",
    "days",
    "data_requests"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "best_day": {
      "type": "string",
      "format": "date"
    },
    "backup_day": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "controlling_hazards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "days": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    },
    "data_requests": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/data_request"
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "snapshot_sha256",
        "rubric_version"
      ],
      "properties": {
        "provider": {
          "const": "typesafe"
        },
        "model": {
          "type": "string",
          "pattern": "^jev-\\d+\\.\\d+\\.\\d+$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rubric_version": {
          "const": 1
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window",
        "score",
        "reason"
      ],
      "properties": {
        "window": {
          "type": "string",
          "enum": [
            "08-10",
            "10-12",
            "12-14",
            "14-16",
            "16-18",
            "18-20"
          ]
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 95,
          "multipleOf": 5
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "confidence",
        "narrative",
        "hazards",
        "windows",
        "confidence_reason",
        "outlook"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 360
        },
        "hazards": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "windows": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "confidence_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "outlook": {
          "type": "string",
          "enum": [
            "Strong go",
            "Probably flyable",
            "Toss-up",
            "Probably not",
            "Practical no-go"
          ]
        },
        "score": {
          "type": "integer",
          "enum": [
            10,
            35,
            55,
            70,
            90
          ]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "data_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "product",
        "priority",
        "reason",
        "expected_benefit",
        "source_url",
        "retrieval"
      ],
      "properties": {
        "product_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,79}$"
        },
        "product": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "expected_benefit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_url": {
          "type": "string",
          "maxLength": 500
        },
        "retrieval": {
          "type": "string",
          "enum": [
            "not_attempted",
            "retrieved",
            "unavailable"
          ]
        }
      }
    }
  }
}
