[Unit]
Description=Refresh KCDW event guidance and live Claude Code narrative
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/projects/kcdw-flyability
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.hermes/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -n var/events-update.lock /usr/bin/python3 -m kcdw.event_update --var var
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/projects/kcdw-flyability/var /home/ubuntu/.claude /home/ubuntu/.claude.json
