[Unit]
Description=Append new KCDW event model cycles and publish changed history
After=network-online.target
Wants=network-online.target

[Service]
Environment=CLAUDE_BIN=/home/andy/.local/bin/claude
Environment=PATH=/home/andy/projects/kcdw-flyability/var/runtime-venv/bin:/home/andy/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/andy/.config/kcdw-flyability/google-adc.json
Environment=WN3_BIGQUERY_PROJECT=aviation-486817
Environment=WN3_BIGQUERY_MAX_BYTES_BILLED=8796093022208
Environment=CLAUDE_CONFIG_DIR=/home/andy/.config/kcdw-flyability/claude
UMask=0077
Type=oneshot
WorkingDirectory=/home/andy/projects/kcdw-flyability
Environment=HOME=/home/andy
ExecStart=/usr/bin/flock -w 60 var/events-update.lock /home/andy/projects/kcdw-flyability/var/runtime-venv/bin/python -m kcdw.history_update --var var
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/andy/projects/kcdw-flyability/var /home/andy/.config/kcdw-flyability/claude
