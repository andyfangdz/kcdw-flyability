[Unit]
Description=Six-hourly KCDW dated-event outlook refresh

[Timer]
# Six-hour polling, about five hours after nominal 00/06/12/18Z cycles.
# Actual publication latency varies; inspect source metadata, not this schedule.
OnCalendar=*-*-* 05,11,17,23:20:00 UTC
Persistent=true
RandomizedDelaySec=3min
Unit=kcdw-flyability-events.service

[Install]
WantedBy=timers.target
